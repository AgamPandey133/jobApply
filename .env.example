# ─────────────────────────────────────────────
#  JobSniper — Environment Variables Template
#  Copy this file to .env and fill in values.
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
DATABASE_URL="postgresql://jobsniper:jobsniper@localhost:5432/jobsniper?schema=public"

# ── Redis ─────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Gemini AI ─────────────────────────────────
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# ── Telegram Bot ──────────────────────────────
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# ── Next.js App ───────────────────────────────
NEXTAUTH_SECRET="generate_a_secret_with_openssl_rand_-base64_32"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Worker Config ────────────────────────────
# How many concurrent apply workers to run
WORKER_APPLY_CONCURRENCY=2
# How many concurrent polling workers to run
WORKER_POLL_CONCURRENCY=5

# ── Playwright ───────────────────────────────
# Set to "true" for visible browser (debugging), "false" for headless
PLAYWRIGHT_HEADLESS="false"
# Slow down Playwright actions by N ms (useful for debugging)
PLAYWRIGHT_SLOW_MO=0

# ── File Storage ─────────────────────────────
# Where resumes and screenshots are stored locally
STORAGE_PATH="./uploads"

# ── Logging ───────────────────────────────────
LOG_LEVEL="info"

# ── Optional: Global Apply Mode ───────────────
# "REVIEW" (default - requires user approval) or "FULL_AUTO"
DEFAULT_APPLY_MODE="REVIEW"

# ── Optional: Matching Score Weights ─────────
# These can also be changed from Settings UI
EMBEDDING_WEIGHT=0.40
LLM_JUDGE_WEIGHT=0.60
MIN_MATCH_SCORE_THRESHOLD=70

# ── Optional: Rate Limiting ───────────────────
# Default polling interval in minutes (can be overridden per company)
DEFAULT_POLL_INTERVAL_MINUTES=2
