{
  "name": "jobsniper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "worker:dev": "tsx watch src/worker/index.ts",
    "worker:build": "tsup src/worker/index.ts --format cjs --out-dir dist/worker --dts",
    "db:generate": "prisma generate && npm run db:postgenerate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:postgenerate": "echo \"export * from './client';\" > src/generated/client/index.ts",
    "build:worker": "tsup src/worker/index.ts --format cjs --out-dir dist/worker"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@playwright/test": "^1.64.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/pg": "^8.23.1",
    "axios": "^1.20.0",
    "bullmq": "^6.3.15",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.57.0",
    "multer": "^2.4.0",
    "next": "16.4.0",
    "node-telegram-bot-api": "^2.1.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "playwright": "^1.64.0",
    "prisma": "^7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/multer": "^2.3.0",
    "@types/node": "^20",
    "@types/node-telegram-bot-api": "^0.64.15",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
